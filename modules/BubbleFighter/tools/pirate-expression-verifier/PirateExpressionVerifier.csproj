<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(LauncherBinaryFolder)' == ''">
    <ProjectReference Include="$(LauncherModuleProject)" />
    <ProjectReference Include="$(LauncherCoreProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(LauncherBinaryFolder)' != ''">
    <Reference Include="$(LauncherBinaryFolder)/FantasyTale.Launcher.Core.dll" />
    <Reference Include="$(LauncherBinaryFolder)/FantasyTale.Launcher.Sdk.dll" />
    <Reference Include="$(LauncherBinaryFolder)/FantasyTale.Launcher.Downloads.dll" />
    <Reference Include="$(LauncherBinaryFolder)/FantasyTale.Launcher.Games.BubbleFighter.dll" />
    <Reference Include="$(LauncherBinaryFolder)/Tomlyn.dll" />
    <Reference Include="$(LauncherBinaryFolder)/System.Security.Cryptography.ProtectedData.dll" />
    <Reference Include="$(LauncherBinaryFolder)/System.Security.Cryptography.Pkcs.dll" />
    <None Include="$(LauncherBinaryFolder)/archive/**/*" LinkBase="archive" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireLauncher" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(LauncherBinaryFolder)' == '' And ('$(LauncherModuleProject)' == '' Or '$(LauncherCoreProject)' == '')"
           Text="Pass the current LauncherModuleProject and LauncherCoreProject, or LauncherBinaryFolder for an older-version rejection check." />
  </Target>
</Project>
