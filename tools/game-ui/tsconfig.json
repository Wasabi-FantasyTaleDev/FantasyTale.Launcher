{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": { "vue": ["../../web/node_modules/vue"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "*.js"]
}
