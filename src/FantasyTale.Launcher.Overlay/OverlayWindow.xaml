<Window x:Class="FantasyTale.Launcher.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Title="FantasyTale Overlay">
    <!--
        Root background uses alpha=1 (not 0) so the layered window's hit-test surface
        covers the whole window when interactive. Switched to alpha=0 for click-through.
    -->
    <Grid x:Name="Root" Background="#01000000">
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="Transparent" />
    </Grid>
</Window>
